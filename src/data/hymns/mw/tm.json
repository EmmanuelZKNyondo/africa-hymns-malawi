{"country":"mw","language":"ch","version":"1.0.0","hymns":[{"number":1,"title":"Mtuwa, Mtuwa, Mtuwa","writer":"--","rating":4.9,"tags":["worship","redemption","salvation"],"content":{"verses":[{"number":1,"lines":[{"text":"Mtuwa, Mtuwa, Mtuwa! Chiura wa nkhongono zonse!","align":"left"},{"text":"Mlenji nzamuyimba sumu...;","align":"left"},{"text":"Mtuwa, Mtuwa, Mtuwa! Wachifundo chosatha!","align":"left"},{"text":"Mlungu mu utatu, Odalitsika!","align":"left"}]},{"number":2,"lines":[{"text":"Oyera, Oyera, Oyera! Mulungu wa mphamvu zonse!","align":"left"}]}],"chorus":null}}]}